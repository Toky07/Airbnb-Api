# URL publique du frontend client (lien d'activation)
APP_PUBLIC_URL=http://localhost:5173

# console | resend | smtp
MAIL_TRANSPORT=resend

# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Airbnb <onboarding@resend.dev>"

# SMTP (optionnel, si MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
