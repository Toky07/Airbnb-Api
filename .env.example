# Database (Docker / production)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=airbnb
DB_PASSWORD=airbnb
DB_NAME=airbnb

# Tests d'intégration locaux (npm run test:e2e) — Postgres requis sur localhost:5432
# DB_HOST=localhost
# DB_NAME=airbnb_test

# Redis cache
REDIS_URL=redis://redis:6379
CACHE_TTL_MS=60000

# API
PORT=3000
UPLOAD_ROOT=uploads

# URL publique du frontend client (lien d'activation)
APP_PUBLIC_URL=http://localhost:5173

# URL publique de l'admin (SPA backend)
ADMIN_PUBLIC_URL=http://localhost:5174

# Origines CORS autorisées (séparées par des virgules). Si vide, utilise APP_PUBLIC_URL + ADMIN_PUBLIC_URL.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# console | resend | smtp
MAIL_TRANSPORT=resend

# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Airbnb <onboarding@resend.dev>"

# SMTP (optionnel, si MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Rate limiting (par IP). THROTTLE_ENABLED=false désactive tout le throttling.
THROTTLE_ENABLED=true
THROTTLE_AUTH_LOGIN_LIMIT=5
THROTTLE_AUTH_LOGIN_TTL_MS=900000
THROTTLE_AUTH_REGISTER_LIMIT=3
THROTTLE_AUTH_REGISTER_TTL_MS=3600000
THROTTLE_AUTH_PASSWORD_SETUP_LIMIT=10
THROTTLE_AUTH_PASSWORD_SETUP_TTL_MS=900000
THROTTLE_IMPORT_LIMIT=5
THROTTLE_IMPORT_TTL_MS=3600000

# HTTP security headers (Helmet). HELMET_ENABLED=false pour désactiver.
HELMET_ENABLED=true
