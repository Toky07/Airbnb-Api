# =============================================================================
# Airbnb API — variables d'environnement
# Copier ce fichier vers .env : cp .env.example .env
# Ne jamais committer .env (secrets, clés API, mots de passe).
# =============================================================================

# -----------------------------------------------------------------------------
# Général
# -----------------------------------------------------------------------------
# development | production
NODE_ENV=development

# true pour ignorer la validation au démarrage (tests uniquement)
# SKIP_ENV_VALIDATION=true

PORT=3000
UPLOAD_ROOT=uploads

# Mot de passe du compte démo créé par `npm run import:sample-data` (interdit en production)
# SAMPLE_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Base de données [SENSIBLE — requis si DB_TYPE=postgres]
# -----------------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=airbnb
DB_PASSWORD=airbnb
DB_NAME=airbnb

# SQLite local (si DB_TYPE=sqlite)
# DB_SQLITE_PATH=database.sqlite

# Tests d'intégration locaux (npm run test:e2e)
# DB_HOST=localhost
# DB_NAME=airbnb_test

# -----------------------------------------------------------------------------
# Authentification JWT [SECRET — requis en production]
# -----------------------------------------------------------------------------
# Générer : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Redis (optionnel)
# -----------------------------------------------------------------------------
REDIS_URL=redis://:changeme-redis@redis:6379
CACHE_TTL_MS=60000

# -----------------------------------------------------------------------------
# URLs publiques (non secrètes, mais critiques pour CORS et emails)
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:5174
# URL publique de l'API (préfixe des images uploadées)
API_PUBLIC_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Mail [SENSIBLE selon le transport]
# console : développement uniquement (logs en console)
# resend  : production recommandée
# smtp    : alternative SMTP
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=console

# Resend [SECRET si MAIL_TRANSPORT=resend]
RESEND_API_KEY=
RESEND_FROM="Airbnb <onboarding@resend.dev>"

# SMTP [SECRETS si MAIL_TRANSPORT=smtp]
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Stripe [SECRETS — requis en production]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# -----------------------------------------------------------------------------
# Sécurité HTTP
# -----------------------------------------------------------------------------
THROTTLE_ENABLED=true
THROTTLE_AUTH_LOGIN_LIMIT=5
THROTTLE_AUTH_LOGIN_TTL_MS=900000
THROTTLE_AUTH_REGISTER_LIMIT=3
THROTTLE_AUTH_REGISTER_TTL_MS=3600000
THROTTLE_AUTH_PASSWORD_SETUP_LIMIT=10
THROTTLE_AUTH_PASSWORD_SETUP_TTL_MS=900000
THROTTLE_IMPORT_LIMIT=5
THROTTLE_IMPORT_TTL_MS=3600000
HELMET_ENABLED=true

# -----------------------------------------------------------------------------
# Swagger (documentation API)
# -----------------------------------------------------------------------------
# Désactivé par défaut (activer uniquement en développement local)
SWAGGER_ENABLED=false
# Chemin UI (ex. http://localhost:3000/docs)
SWAGGER_PATH=docs

# -----------------------------------------------------------------------------
# Tarification checkout (optionnel)
# -----------------------------------------------------------------------------
# TVA hébergement meublé (décimal, ex. 0.10 = 10 %)
# VAT_RATE=0.10
# Frais de service (décimal, ex. 0.05 = 5 %)
# SERVICE_FEE_PERCENT=0

# -----------------------------------------------------------------------------
# Facturation / marque (optionnel)
# -----------------------------------------------------------------------------
# INVOICE_BRAND_NAME=StayBook
# INVOICE_BRAND_COLOR=#FF385C
# INVOICE_LOGO_PATH=
# INVOICE_ISSUER_NAME=StayBook SAS
# INVOICE_ISSUER_ADDRESS=1 rue Example, 75001 Paris
# INVOICE_SIRET=
# INVOICE_VAT_NUMBER=
# BRAND_NAME=StayBook
# SUPPORT_EMAIL=support@staybook.app
